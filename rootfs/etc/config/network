# SK-D840N (zte,133) network layout.
#
# Keep this in the image instead of relying on config_generate to infer the
# topology on first boot.  The board has one WAN MAC (eth0) and three LAN
# MACs (eth1-eth3); putting the LAN MACs in a bridge is required for both
# switching between LAN ports and forwarding/NAT through the WAN zone.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'auto'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'
	list ports 'eth2'
	list ports 'eth3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'eth0'
	option proto 'dhcp'

config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'
